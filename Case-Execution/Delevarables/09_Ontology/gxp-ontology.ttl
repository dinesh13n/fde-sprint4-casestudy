gx:Category_identity_security a owl:Class ;
    rdfs:label "Identity Security" ;
    rdfs:comment "Grouping class: entity category 'identity_security'." .

gx:SourceContract a owl:Class ;
    rdfs:label "SourceContract" ;
    rdfs:comment "Declared shape of messages from a source (integration/source-contract-v1.json). Binding mode is per source: record_only (default) or enforce." ;
    rdfs:subClassOf gx:Category_integration ;
    gx:category "integration" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/21-integration/data-contracts.md",
        "hub/intake/contracts/source-contract-v1.json",
        "integration/source-contract-v1.json" ;
    gx:mutability "reference_data" ;
    gx:sensitivity "C1" .

gx:UpstreamOutage a owl:Class ;
    rdfs:label "UpstreamOutage" ;
    rdfs:comment "A recorded outage or partial rerun of an upstream system, with began/resolved times; some are unresolved." ;
    rdfs:subClassOf gx:Category_operations ;
    gx:category "operations" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/partner-feed-operations.md" ;
    gx:legacyColumn "upstream_outages.incident_id" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'upstream_outages', 'rows_in_baseline': 72}" ;
    gx:mutability "mutable_snapshot" ;
    gx:sensitivity "C1" .

gx:Category_operations a owl:Class ;
    rdfs:label "Operations" ;
    rdfs:comment "Grouping class: entity category 'operations'." .

gx:SOP a owl:Class ;
    rdfs:label "SOP" ;
    rdfs:comment "A Standard Operating Procedure version with an effective window. Versions are effective-dated; supersession is a window, not an overwrite." ;
    rdfs:subClassOf gx:Category_reference_data ;
    gx:category "reference_data" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/domain-contracts.md" ;
    gx:legacyColumn "sop_versions.(sop_id,version)" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'sop_versions', 'rows_in_baseline': 45}" ;
    gx:mutability "reference_data" ;
    gx:sensitivity "C1" .

gx:Category_measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "Grouping class: entity category 'measurement'." .

gx:DeviationRegisterEntry a owl:Class ;
    rdfs:label "DeviationRegisterEntry" ;
    rdfs:comment "A recorded difference between legacy behaviour (golden baseline) and hub behaviour (DV-01..DV-11) with a preserve-or-fix decision. Acceptable only if approved with an approval reference (none approved yet)." ;
    rdfs:subClassOf gx:Category_governance ;
    gx:category "governance" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/business-rules.md",
        "docs/16-repo-validation/behavior-difference-report.md" ;
    gx:identityPattern "^DV-[0-9]{2}$" ;
    gx:mutability "append_only" ;
    gx:sensitivity "C1" .

gx:OperatingCost a owl:Class ;
    rdfs:label "OperatingCost" ;
    rdfs:comment "Monthly modelled operating-cost estimate (labour hours, cases, infrastructure USD). total_cases is NOT 'cases created' (random; OD-07). Any metric using it is basis = modelled." ;
    rdfs:subClassOf gx:Category_measurement ;
    gx:category "measurement" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence ".fde/orchestrator-decisions.md",
        "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:legacyColumn "operating_costs.period" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'operating_costs', 'rows_in_baseline': 36}" ;
    gx:mutability "mutable_snapshot" ;
    gx:sensitivity "C2" .

gx:ReferenceVersion a owl:Class ;
    rdfs:label "ReferenceVersion" ;
    rdfs:comment "Versioned master/reference value with an overlapping validity window; requires temporal interpretation (which version applied at time T)." ;
    rdfs:subClassOf gx:Category_reference_data ;
    gx:category "reference_data" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/11-data-context/knowledge-model.md",
        "docs/partner-feed-operations.md" ;
    gx:legacyColumn "reference_versions.(ref_key,version)" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'reference_versions', 'rows_in_baseline': 180}" ;
    gx:mutability "reference_data" ;
    gx:sensitivity "C1" .

gx:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "An operating site, referenced by cases and batches through local aliases. Backlog and exception measures are always reported per site." ;
    rdfs:subClassOf gx:Category_reference_data ;
    gx:category "reference_data" ;
    gx:epistemicStatus "inference" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/11-data-context/knowledge-model.md" ;
    gx:legacyColumn "cases.site" .

gx:SourceSystem a owl:Class ;
    rdfs:label "SourceSystem" ;
    rdfs:comment "An upstream system or partner feed: ElectronicBatchRecord (publishes OOS_RESULT, DEVIATION, CAPA_UPDATE), LIMS-QMS (competing facts and effective-dated master data), and the partner gateway. Their messages are data, never instructions." ;
    rdfs:subClassOf gx:Category_integration ;
    gx:category "integration" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/21-integration/integration-inventory.md",
        "docs/partner-feed-operations.md",
        "docs/source-systems-and-constraints.md" ;
    gx:mutability "external_read_only" ;
    gx:sensitivity "C1" .

gx:CaseState a owl:Class ;
    rdfs:label "CaseState" ;
    rdfs:comment "The current state of a case, derived by folding its DecisionEvents. A rebuildable projection, never an independent source of truth." ;
    rdfs:subClassOf gx:Category_decision_record ;
    gx:category "decision_record" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/contracts/ddl/hub-schema-v0.1.sql",
        "docs/20-application/state-model.md" ;
    gx:mutability "derived_projection" ;
    gx:sensitivity "C2" .

