    rdfs:label "VAL-06" ;
    rdfs:comment "Matching is exact string equality after Unicode NFC normalisation and trim on registered keys only. 0 hits = UNMATCHED_REF, 1 = link, more than 1 = AMBIGUOUS_MATCH. No fuzzy or similarity matching of any kind." ;
    gx:appliesTo gx:CrosswalkLink,
        gx:FeedItem ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/business-rules.md" ;
    gx:ruleCategory "validation" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/VAL_07> a gx:BusinessRule ;
    rdfs:label "VAL-07" ;
    rdfs:comment "Percentiles: median is the mean of the middle two values for even n; p90 is nearest-rank ceil(0.9 n); n = 0 yields null, never 0. (Convention chosen for testability; the owner may change it as policy.)" ;
    gx:appliesTo gx:MetricValue ;
    gx:epistemicStatus "assumption" ;
    gx:evidence "docs/12-specs/business-rules.md" ;
    gx:ruleCategory "validation" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/VAL_08> a gx:BusinessRule ;
    rdfs:label "VAL-08" ;
    rdfs:comment "A metric whose category is time or age, or whose name/window/denominator/documentation mentions closed, closure, resolved, resolution, approved, approval, cost or handling, cannot be registered without a definition tag." ;
    gx:appliesTo gx:MetricDefinition ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "hub/metrics/registry.py" ;
    gx:ruleCategory "validation" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/VAL_09> a gx:BusinessRule ;
    rdfs:label "VAL-09" ;
    rdfs:comment "operating_costs.total_cases is never accepted as 'cases created'; any metric sourced from operating_costs has basis = modelled." ;
    gx:appliesTo gx:MetricDefinition,
        gx:OperatingCost ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence ".fde/orchestrator-decisions.md",
        "hub/metrics/registry.py" ;
    gx:ruleCategory "validation" ;
    gx:strength "MUST_NOT" .

<https://example.org/gxp-hub/id/rule/VAL_10> a gx:BusinessRule ;
    rdfs:label "VAL-10" ;
    rdfs:comment "Item-level processing order: store raw -> identity/hash comparison (no-op duplicate or conflict) -> validate -> classify -> match -> outcome. A conflict still records validation results in all_reasons." ;
    gx:appliesTo gx:FeedItem,
        gx:Run ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/business-rules.md" ;
    gx:ruleCategory "validation" ;
    gx:strength "MUST" .

