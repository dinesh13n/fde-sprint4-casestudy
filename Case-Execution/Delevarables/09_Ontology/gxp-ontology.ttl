    rdfs:label "PolicyObject" ;
    rdfs:comment "A versioned, owned, effective-dated statement of business meaning: a definition of closed/resolved/approved, a clock (e.g. the '48 h' closure expectation), a closure policy, a consistency policy or a cut-off. The product ships with NONE adopted; adoption is a Zone H action." ;
    rdfs:subClassOf gx:Category_policy ;
    gx:category "policy" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/11-data-context/knowledge-model.md",
        "docs/12-specs/contracts/ddl/hub-schema-v0.1.sql",
        "docs/12-specs/features/f03-policy-definitions-rule-service.md" ;
    gx:mutability "versioned_immutable" ;
    gx:sensitivity "C2" ;
    gx:statusVocabulary vc:vocab_policy_status .

