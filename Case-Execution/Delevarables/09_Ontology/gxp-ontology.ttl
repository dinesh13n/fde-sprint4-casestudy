    rdfs:domain gx:PolicyObject ;
    rdfs:range xsd:string .

gx:PolicyObject_status a owl:DatatypeProperty ;
    rdfs:label "PolicyObject.status" ;
    rdfs:comment "candidate | adopted | accepted-open (vocab.policy_status). 'accepted-open' means a human recorded that the question is deliberately undecided." ;
    rdfs:domain gx:PolicyObject ;
    rdfs:range xsd:string .

gx:Principal_actor_kind a owl:DatatypeProperty ;
