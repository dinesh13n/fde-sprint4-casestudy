<https://example.org/gxp-hub/id/role/compliance> a gx:Role ;
    rdfs:label "compliance" ;
    rdfs:comment "May: read audit records and exports" .

<https://example.org/gxp-hub/id/role/dispositioner> a gx:Role ;
    rdfs:label "dispositioner" ;
    rdfs:comment "May: perform Zone H actions ZH-01..ZH-10 once holders exist" .

<https://example.org/gxp-hub/id/role/finance_read> a gx:Role ;
    rdfs:label "finance_read" ;
    rdfs:comment "May: read money metrics only; no write" .

<https://example.org/gxp-hub/id/role/integration> a gx:Role ;
    rdfs:label "integration" ;
    rdfs:comment "May: service principal for feed intake; may never perform a Zone H action" .

<https://example.org/gxp-hub/id/role/quality_lead> a gx:Role ;
    rdfs:label "quality_lead" ;
    rdfs:comment "May: read quality views, propose policy objects" .

<https://example.org/gxp-hub/id/role/reviewer> a gx:Role ;
    rdfs:label "reviewer" ;
    rdfs:comment "May: review queue items, record STATUS_REVIEWED decisions" .

<https://example.org/gxp-hub/id/rule/BR_01> a gx:BusinessRule ;
    rdfs:label "BR-01" ;
    rdfs:comment "Every reported figure that involves closed, resolved, cost or handling time declares which definition of the state it uses; figures built on different definitions are never combined or compared." ;
    gx:appliesTo gx:MetricDefinition,
        gx:MetricValue ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/03-problem-value/business-requirements.md",
        "docs/12-specs/business-rules.md" ;
    gx:implements "FR-MET-01",
        "FR-MET-02" ;
    gx:ruleCategory "business_requirement" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/BR_02> a gx:BusinessRule ;
    rdfs:label "BR-02" ;
    rdfs:comment "The organisation records WHO decides the definition of closed/resolved and the closure-time expectation. The product never chooses it." ;
    gx:appliesTo gx:PolicyObject ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/03-problem-value/business-requirements.md",
        "docs/06-root-cause/confirmed-root-causes.md" ;
    gx:ruleCategory "business_requirement" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/BR_03> a gx:BusinessRule ;
    rdfs:label "BR-03" ;
    rdfs:comment "Time-to-close is measurable under each candidate definition (receipt to ops-closed, receipt to evidence-complete) without prejudging which is correct." ;
    gx:appliesTo gx:Case,
        gx:DecisionEvent ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/03-problem-value/business-requirements.md" ;
    gx:implements "FR-DEC-06",
        "FR-MET-03" ;
    gx:ruleCategory "business_requirement" ;
    gx:strength "MUST" .

<https://example.org/gxp-hub/id/rule/BR_04> a gx:BusinessRule ;
    rdfs:label "BR-04" ;
    rdfs:comment "Externally received case information is matched to exactly one core case, or flagged unmatched, before it reaches a reviewer queue." ;
    gx:appliesTo gx:Case,
        gx:FeedItem ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/03-problem-value/business-requirements.md" ;
    gx:implements "FR-INT-05" ;
    gx:ruleCategory "business_requirement" ;
    gx:strength "MUST" .

