gx:ZoneHAction a owl:Class ;
    rdfs:label "ZoneHAction" ;
    rdfs:comment "A Zone H action requires a named human holder, a recorded reason and evidence reference. Service actors are refused (FR-GATE-03). With zero holders every action is refused.",
        "One of ten closed, human-only actions (ZH-01..ZH-10) that automation may never perform: batch disposition, QA release, e-signature record, close-exception, policy adopt, rule-set activate, exception-rule accept, disposition-mode change, schedule enable/disable, policy change." ;
    rdfs:subClassOf gx:Category_governance ;
    gx:category "governance" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/features/f02-human-disposition-gate.md",
        "docs/23-human-control/approval-gates.md",
        "hub/gate/actions.py" ;
    gx:identityPattern "^ZH-(0[1-9]|10)$" ;
    gx:mutability "reference_data" ;
    gx:sensitivity "C3" .

