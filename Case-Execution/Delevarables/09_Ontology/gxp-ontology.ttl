gx:FeedItem a owl:Class ;
    rdfs:label "FeedItem" ;
    rdfs:comment "One message received from a source, kept exactly as received. Its identity is the natural key (partner, record_kind, ref_id, source_ts); business_key and feed_id are NOT identities." ;
    rdfs:subClassOf gx:Category_integration ;
    gx:category "integration" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/06-root-cause/confirmed-root-causes.md",
        "docs/11-data-context/knowledge-model.md",
        "docs/12-specs/business-rules.md" ;
    gx:legacyColumn "partner_feeds.feed_id" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'partner_feeds', 'rows_in_baseline': 8567}" ;
    gx:mutability "append_only" ;
    gx:sensitivity "C2" .

