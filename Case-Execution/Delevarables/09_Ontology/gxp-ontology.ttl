gx:DecisionEvent a owl:Class ;
    rdfs:label "DecisionEvent" ;
    rdfs:comment "An immutable, hash-chained fact about a case: a state change, evidence attachment, human disposition, override or correction. The record of WHO decided WHAT, WHEN, ON WHAT BASIS and WITH WHICH EVIDENCE. Never updated or deleted; corrections are new events." ;
    rdfs:subClassOf gx:Category_decision_record ;
    gx:category "decision_record" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/business-rules.md",
        "docs/12-specs/contracts/ddl/hub-schema-v0.1.sql",
        "docs/12-specs/features/f01-decision-evidence-record.md" ;
    gx:mutability "append_only" ;
    gx:sensitivity "C2" .

gx:Case a owl:Class ;
    rdfs:label "Case" ;
    rdfs:comment "A unit of quality-operations work: a batch-quality review / deviation-handling case that moves through a review lifecycle and may end in a human batch-disposition decision. In the legacy estate a case is a mutable row; in the target model a case is the sequence of immutable decision events recorded about it." ;
    rdfs:subClassOf gx:Category_business_object ;
    gx:category "business_object" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/06-root-cause/confirmed-root-causes.md",
        "docs/11-data-context/knowledge-model.md",
        "docs/business-context.md",
        "docs/data-dictionary.md" ;
    gx:identityPattern "^C[0-9]{8}$" ;
    gx:legacyColumn "cases.id" ;
    gx:legacySource "{'store': 'data/legacy.sqlite3', 'table': 'cases', 'rows_in_baseline': 125}" ;
    gx:mutability "mutable_snapshot" ;
    gx:sensitivity "C2" ;
    gx:statusVocabulary vc:vocab_case_status .

gx:BusinessRule a owl:Class .

gx:MetricDefinition a owl:Class ;
    rdfs:label "MetricDefinition" ;
    rdfs:comment "A declared measure: category, window, denominator, exclusions, basis and — where closed/resolved/approved/cost/handling is involved — a mandatory definition tag. Versioned and immutable." ;
    rdfs:subClassOf gx:Category_measurement ;
    gx:category "measurement" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/12-specs/features/f07-metrics-definition-tags.md",
        "hub/metrics/registry.py" ;
    gx:mutability "versioned_immutable" ;
    gx:sensitivity "C1" .

