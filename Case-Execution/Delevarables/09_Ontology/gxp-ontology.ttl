<https://example.org/gxp-hub/id/metric/MET_INV_03> a gx:MetricDefinition ;
    rdfs:label "MET-INV-03 zone_h_service_actor_accepted" ;
    rdfs:comment "" ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/31-observability/slo-sla-definitions.md" .

<https://example.org/gxp-hub/id/metric/MET_MONTH_END_TOTAL> a gx:MetricDefinition ;
    rdfs:label "MET-MONTH-END-TOTAL Month-end total of case amounts" ;
    rdfs:comment "" ;
    gx:computableToday true ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/06-root-cause/confirmed-root-causes.md",
        "hub/metrics/registry.py" ;
    gx:formula "Exact decimal sum of cases.amount, one query on one table (no join, no fan-out), quantised to 2 decimals ROUND_HALF_EVEN at presentation" .

<https://example.org/gxp-hub/id/metric/MET_TTC_C_EVID> a gx:MetricDefinition ;
    rdfs:label "MET-TTC-C-EVID Time to evidence-complete (clock C-EVID)" ;
    rdfs:comment "" ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "hub/metrics/registry.py" ;
    gx:formula "Same method as MET-TTC-C-OPS under the evidence-complete clock; a different definition, never combined with it." .

<https://example.org/gxp-hub/id/metric/MET_TTC_C_OPS> a gx:MetricDefinition ;
    rdfs:label "MET-TTC-C-OPS Time to ops-closed (clock C-OPS)" ;
    rdfs:comment "" ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "hub/metrics/registry.py" ;
    gx:formula "Median and p90 of elapsed hours between the clock's start and stop events per completed cycle" .

<https://example.org/gxp-hub/id/metric/MET_UNRESOLVED_EXC_RATE_D_OPS> a gx:MetricDefinition ;
    rdfs:label "MET-UNRESOLVED-EXC-RATE-D-OPS Unresolved-exception rate per site (D-OPS)" ;
    rdfs:comment "" ;
    gx:computableToday true ;
    gx:definitionClass "none" ;
