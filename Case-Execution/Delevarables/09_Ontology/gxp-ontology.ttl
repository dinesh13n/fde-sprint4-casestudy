@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gx: <https://example.org/gxp-hub/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vc: <https://example.org/gxp-hub/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/gxp-hub/id/metric/K_01> a gx:MetricDefinition ;
    rdfs:label "K-01 Unsafe action count" ;
    rdfs:comment "Automated or simulated disposition, or closure without evidence and without an authorised exception." ;
    gx:computableToday false ;
    gx:definitionClass "invariant_zero_required" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/34-measure-after/after-intervention-kpi-sheet.md" ;
    gx:formula "count(unsafe events in window)" ;
    gx:unit "count" .

<https://example.org/gxp-hub/id/metric/K_02> a gx:MetricDefinition ;
    rdfs:label "K-02 Source attribution rate" ;
    rdfs:comment "Share of sampled decisions carrying an evidence reference and a source." ;
    gx:computableToday true ;
    gx:definitionClass "structural_proxy" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "decisions with evidence_ref AND source / decisions sampled" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_03> a gx:MetricDefinition ;
    rdfs:label "K-03 Definition transparency" ;
    rdfs:comment "Share of reported figures that declare which closed/resolved definition they use." ;
    gx:computableToday true ;
    gx:definitionClass "verified_by_inspection" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "figures with definition tag / figures reported" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_04_EVID> a gx:MetricDefinition ;
    rdfs:label "K-04-EVID Time to close (D-EVID)" ;
    rdfs:comment "Elapsed time receipt -> closed AND evidence + authorised approver recorded." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "median/p90 of (max(closed_at, evidence_at, approver_at) - created_at)" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/K_04_FIN> a gx:MetricDefinition ;
    rdfs:label "K-04-FIN Time to resolved (D-FIN)" ;
    rdfs:comment "Elapsed time receipt -> 'successfully resolved for cost'." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "unknown" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "UNDEFINED (D-FIN is an unknown)" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/K_04_OPS> a gx:MetricDefinition ;
    rdfs:label "K-04-OPS Time to close (D-OPS)" ;
    rdfs:comment "Elapsed time receipt -> operations-closed." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "median and p90 of (closed_at - created_at) over cases with status CLOSED" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/K_05> a gx:MetricDefinition ;
    rdfs:label "K-05 Time to evidence" ;
    rdfs:comment "Receipt -> evidence-complete." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/34-measure-after/after-intervention-kpi-sheet.md" ;
    gx:formula "median hours (evidence_complete_at - created_at)" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/K_06> a gx:MetricDefinition ;
    rdfs:label "K-06 Unmatched reference rate" ;
    rdfs:comment "External items whose reference matches no core case." ;
    gx:computableToday true ;
    gx:definitionClass "definition_independent" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/42-executive-defence/lessons-learned.md" ;
    gx:formula "count(ref_id NOT IN cases.id) / count(rows)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_07> a gx:MetricDefinition ;
    rdfs:label "K-07 Replay safety" ;
    rdfs:comment "Change in queue size and totals when an already-processed item is re-delivered." ;
    gx:computableToday true ;
    gx:definitionClass "invariant_zero_required" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/34-measure-after/after-intervention-kpi-sheet.md" ;
    gx:formula "queue_after - queue_before; totals_after - totals_before, after replay of n processed items" ;
    gx:unit "count" .

<https://example.org/gxp-hub/id/metric/K_08> a gx:MetricDefinition ;
    rdfs:label "K-08 Reconciliation delay" ;
    rdfs:comment "Hours from source event to record available." ;
    gx:computableToday true ;
    gx:definitionClass "definition_independent" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/operations-service-levels.md" ;
    gx:formula "ingest_ts - source_ts; median, p90, share <= 4 h" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/K_09U> a gx:MetricDefinition ;
    rdfs:label "K-09U Unresolved exception rate" ;
    rdfs:comment "Share of policy exceptions not resolved. UE-1: outcome <> 'WAIVED'. UE-2: outcome IN ('OPEN','REVIEW')." ;
    gx:computableToday true ;
    gx:definitionClass "provisional_meaning_of_WAIVED_BLOCKED_unowned" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count / count(policy_exceptions)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_09_EVID> a gx:MetricDefinition ;
    rdfs:label "K-09-EVID Backlog (D-EVID)" ;
    rdfs:comment "Cases not both closed and evidence-complete." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count(cases) - count(closed AND evidence AND approver)" ;
    gx:unit "count" .

<https://example.org/gxp-hub/id/metric/K_09_FIN> a gx:MetricDefinition ;
    rdfs:label "K-09-FIN Backlog (D-FIN)" ;
    rdfs:comment "Undefined." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "unknown" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "UNDEFINED" ;
    gx:unit "count" .

<https://example.org/gxp-hub/id/metric/K_09_OPS> a gx:MetricDefinition ;
    rdfs:label "K-09-OPS Backlog ageing and count (D-OPS)" ;
    rdfs:comment "Not-closed cases and their age at AS_OF, per site (BR-12)." ;
    gx:computableToday true ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/34-measure-after/after-intervention-kpi-sheet.md" ;
    gx:formula "count(status <> 'CLOSED'); median/p90 of (AS_OF - created_at)" ;
    gx:unit "count; days" .

<https://example.org/gxp-hub/id/metric/K_10> a gx:MetricDefinition ;
    rdfs:label "K-10 Month-end comparability" ;
    rdfs:comment "Operations month counts vs finance/cost month counts on one cut-off." ;
    gx:computableToday true ;
    gx:definitionClass "definition_dependent_cutoff_unowned" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence ".fde/orchestrator-decisions.md",
        "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "months where cases created in month = operating_costs.total_cases / months compared" ;
    gx:unit "months; cases" .

<https://example.org/gxp-hub/id/metric/K_11> a gx:MetricDefinition ;
    rdfs:label "K-11 Decision recorded" ;
    rdfs:comment "The definition decision and closure-time decision each have an owner+date or an 'accepted open' record." ;
    gx:computableToday true ;
    gx:definitionClass "governance" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/34-measure-after/after-intervention-kpi-sheet.md" ;
    gx:formula "count(DR-20, DR-21 with decision record) / 2" ;
    gx:unit "count of 2" .

<https://example.org/gxp-hub/id/metric/K_12> a gx:MetricDefinition ;
    rdfs:label "K-12 Handling effort per case" ;
    rdfs:comment "Labour hours per case." ;
    gx:computableToday true ;
    gx:definitionClass "denominator_is_operating_costs_not_cases" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "sum(labor_hours) / sum(total_cases) from operating_costs" ;
    gx:unit "hours per case" .

<https://example.org/gxp-hub/id/metric/K_13> a gx:MetricDefinition ;
    rdfs:label "K-13 Infrastructure cost per case" ;
    rdfs:comment "Infrastructure spend per case." ;
    gx:computableToday true ;
    gx:definitionClass "cost_proxy_D-FIN_dependent" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "sum(infrastructure_usd) / sum(total_cases)" ;
    gx:unit "USD per case" .

<https://example.org/gxp-hub/id/metric/K_14> a gx:MetricDefinition ;
    rdfs:label "K-14 Throughput" ;
    rdfs:comment "Cases created per month." ;
    gx:computableToday true ;
    gx:definitionClass "definition_independent" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count(cases) / months with data" ;
    gx:unit "cases per month" .

<https://example.org/gxp-hub/id/metric/K_15> a gx:MetricDefinition ;
    rdfs:label "K-15 Rework (reopen) rate" ;
    rdfs:comment "Share of cases in REOPENED." ;
    gx:computableToday true ;
    gx:definitionClass "snapshot_proxy" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count(status = 'REOPENED') / count(cases)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_16> a gx:MetricDefinition ;
    rdfs:label "K-16 Manual-review share (by code rule)" ;
    rdfs:comment "Share of cases the legacy rule flags for manual review." ;
    gx:computableToday true ;
    gx:definitionClass "rule_derived" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "app/legacy_logic.py",
        "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count(manual_review_required) / count(cases)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_17> a gx:MetricDefinition ;
    rdfs:label "K-17 Deviations closed without root cause" ;
    rdfs:comment "Integrity of closure." ;
    gx:computableToday true ;
    gx:definitionClass "quality" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "count(CLOSED AND root_cause IS NULL) / count(CLOSED) in deviations" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_18> a gx:MetricDefinition ;
    rdfs:label "K-18 CAPA overdue share" ;
    rdfs:comment "OVERDUE share of not-yet-verified CAPA." ;
    gx:computableToday true ;
    gx:definitionClass "quality" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "OVERDUE / (OVERDUE + OPEN)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_19> a gx:MetricDefinition ;
    rdfs:label "K-19 Batch-run rejection / failure" ;
    rdfs:comment "Rejected records over input; FAILED runs over runs." ;
    gx:computableToday true ;
    gx:definitionClass "error" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/baseline-kpi-sheet.md",
        "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "sum(rejected) / sum(input); count(FAILED) / count(runs)" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_20> a gx:MetricDefinition ;
    rdfs:label "K-20 Upstream outage MTTR and open outages" ;
    rdfs:comment "Median resolve time; outages with no resolve time." ;
    gx:computableToday true ;
    gx:definitionClass "reliability" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/baseline-kpi-sheet.md",
        "docs/04-baseline-kpis/kpi-dictionary.md" ;
    gx:formula "median(resolved - began); count(resolved IS NULL)" ;
    gx:unit "hours; count" .

<https://example.org/gxp-hub/id/metric/K_21> a gx:MetricDefinition ;
    rdfs:label "K-21 Adoption" ;
    rdfs:comment "Share of cases handled via the new capability." ;
    gx:computableToday false ;
    gx:definitionClass "not_measurable_pre_intervention" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/final-prd/final-as-built-prd.md" ;
    gx:formula "cases via new path / cases" ;
    gx:unit "percent" .

<https://example.org/gxp-hub/id/metric/K_22> a gx:MetricDefinition ;
    rdfs:label "K-22 Rework effort" ;
    rdfs:comment "Hours spent on avoidable rework." ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "unknown" ;
    gx:evidence "docs/04-baseline-kpis/kpi-dictionary.md",
        "docs/42-executive-defence/lessons-learned.md" ;
    gx:formula "sum of rework hours (needs a time record)" ;
    gx:unit "hours" .

<https://example.org/gxp-hub/id/metric/MET_BACKLOG_D_OPS> a gx:MetricDefinition ;
    rdfs:label "MET-BACKLOG-D-OPS Backlog and ageing per site (D-OPS)" ;
    rdfs:comment "" ;
    gx:computableToday true ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence "hub/metrics/registry.py" ;
    gx:formula "Cases not in the closing-state set at as_of, per site, with ageing buckets <=90, 91-365, 366-730, >730 days from creation" .

<https://example.org/gxp-hub/id/metric/MET_INV_01> a gx:MetricDefinition ;
    rdfs:label "MET-INV-01 model_calls_total" ;
    rdfs:comment "" ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
    gx:evidence ".fde/orchestrator-decisions.md",
        "docs/31-observability/slo-sla-definitions.md" .

<https://example.org/gxp-hub/id/metric/MET_INV_02> a gx:MetricDefinition ;
    rdfs:label "MET-INV-02 egress_attempts_total" ;
    rdfs:comment "" ;
    gx:computableToday false ;
    gx:definitionClass "none" ;
    gx:epistemicStatus "verified_fact" ;
