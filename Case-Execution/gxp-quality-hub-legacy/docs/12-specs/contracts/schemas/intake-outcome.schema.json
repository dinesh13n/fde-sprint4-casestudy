{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:intake-outcome",
  "title": "intake-outcome",
  "description": "Append-only intake outcome (FR-INT-02/03/04/06) (Stage 12 v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "raw_id": {
      "type": "string"
    },
    "outcome_seq": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "VALIDATED",
        "VALIDATED_WITH_FLAGS",
        "EXCEPTION",
        "QUARANTINED",
        "NOOP_DUPLICATE",
        "CONFLICT_RESOLVED"
      ]
    },
    "primary_reason": {
      "enum": [
        "UNSUPPORTED_REVISION",
        "INVALID_JSON",
        "MISSING_ENVELOPE_FIELD",
        "UNKNOWN_RECORD_KIND",
        "MISSING_PAYLOAD_FIELD",
        "CONTRACT_VIOLATION",
        "REVISED_CONFLICT",
        "UNPARSABLE_AMOUNT",
        "NO_BUSINESS_KEY",
        "AMBIGUOUS_MATCH",
        "UNMATCHED_REF",
        "NEGATIVE_VALUE",
        "UNKNOWN_UNIT",
        "UNKNOWN_CURRENCY",
        "IDENTIFIER_PATTERN",
        null
      ]
    },
    "all_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "UNSUPPORTED_REVISION",
          "INVALID_JSON",
          "MISSING_ENVELOPE_FIELD",
          "UNKNOWN_RECORD_KIND",
          "MISSING_PAYLOAD_FIELD",
          "CONTRACT_VIOLATION",
          "REVISED_CONFLICT",
          "UNPARSABLE_AMOUNT",
          "NO_BUSINESS_KEY",
          "AMBIGUOUS_MATCH",
          "UNMATCHED_REF",
          "NEGATIVE_VALUE",
          "UNKNOWN_UNIT",
          "UNKNOWN_CURRENCY",
          "IDENTIFIER_PATTERN"
        ]
      },
      "uniqueItems": true
    },
    "queue": {
      "enum": [
        "quarantine_invalid",
        "revision_review",
        "unmatched",
        "ambiguous_match",
        "flagged_value",
        null
      ]
    },
    "contract_check": {
      "enum": [
        "pass",
        "fail",
        "not_bound"
      ]
    },
    "counts_toward_totals": {
      "type": "boolean"
    },
    "matched_link": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution": {
      "enum": [
        "accept_revision",
        "keep_original",
        "reject_both",
        null
      ]
    },
    "resolution_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    }
  },
  "required": [
    "raw_id",
    "outcome_seq",
    "outcome",
    "all_reasons",
    "contract_check",
    "counts_toward_totals",
    "run_id",
    "decided_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "CONFLICT_RESOLVED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "resolution",
          "resolution_reason",
          "resolved_by"
        ],
        "properties": {
          "resolution": {
            "type": "string"
          },
          "resolution_reason": {
            "type": "string",
            "minLength": 1
          },
          "resolved_by": {
            "type": "string",
            "minLength": 1
          },
          "queue": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NOOP_DUPLICATE"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "counts_toward_totals": {
            "const": false
          },
          "queue": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "QUARANTINED",
              "EXCEPTION"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "primary_reason",
          "queue"
        ],
        "properties": {
          "primary_reason": {
            "type": "string"
          },
          "queue": {
            "type": "string"
          }
        }
      }
    }
  ]
}
