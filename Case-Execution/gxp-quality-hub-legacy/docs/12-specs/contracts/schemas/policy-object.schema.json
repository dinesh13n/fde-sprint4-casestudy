{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:policy-object",
  "title": "policy-object",
  "description": "Versioned policy object (FR-POL-01/02; ships with no 'adopted' row) (Stage 12 v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "DEFINITION",
        "CLOCK",
        "CLOSURE",
        "CONSISTENCY",
        "CUTOFF"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "object"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "adopted",
        "accepted-open"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    }
  },
  "required": [
    "policy_id",
    "version",
    "kind",
    "name",
    "body",
    "owner",
    "status",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CLOCK"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "clock_start_event",
              "clock_stop_event",
              "calendar_basis"
            ],
            "properties": {
              "clock_start_event": {
                "type": "string"
              },
              "clock_stop_event": {
                "type": "string"
              },
              "duration_hours": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "candidate_duration_hours": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "calendar_basis": {
                "enum": [
                  "wall_clock",
                  "business_calendar"
                ]
              },
              "calendar_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "if": {
              "properties": {
                "calendar_basis": {
                  "const": "business_calendar"
                }
              },
              "required": [
                "calendar_basis"
              ]
            },
            "then": {
              "required": [
                "calendar_ref"
              ],
              "properties": {
                "calendar_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "adopted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "effective_from",
          "owner"
        ],
        "properties": {
          "effective_from": {
            "type": "string"
          },
          "owner": {
            "not": {
              "const": "unassigned"
            }
          }
        }
      }
    }
  ]
}
