{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:audit-record",
  "title": "audit-record",
  "description": "Hash-chained audit record (FR-SEC-02; ADR-005) (Stage 12 v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "audit_seq": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "actor": {
      "type": "string"
    },
    "actor_kind": {
      "enum": [
        "human",
        "service",
        "rule",
        "system"
      ]
    },
    "action": {
      "type": "string"
    },
    "object_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "denied",
        "error"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "audit_seq",
    "occurred_at",
    "actor",
    "actor_kind",
    "action",
    "outcome",
    "correlation_id",
    "details",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false
}
