{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:decision-event",
  "title": "decision-event",
  "description": "Immutable insert-only decision/fact event (DC-10, FR-DEC-01..06) (Stage 12 v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{8}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "CASE_CREATED",
        "CASE_IMPORTED",
        "STATUS_CHANGE",
        "REOPEN",
        "EVIDENCE_ATTACHED",
        "FACT_RECEIVED",
        "FACT_OPS_CLOSED",
        "FACT_EVIDENCE_COMPLETE",
        "CLOSE_EXCEPTION",
        "DISPOSITION_RECORDED",
        "DISPOSITION_REFERENCED",
        "QA_RELEASE_RECORDED",
        "ESIGNATURE_RECORDED",
        "OVERRIDE_RECORDED",
        "CORRECTION"
      ]
    },
    "from_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "OPEN",
        "UNDER_REVIEW",
        "CLOSED",
        "ESCALATED",
        "REOPENED",
        null
      ]
    },
    "to_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "OPEN",
        "UNDER_REVIEW",
        "CLOSED",
        "ESCALATED",
        "REOPENED",
        null
      ]
    },
    "affects_state": {
      "type": "boolean"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "actor_kind": {
      "enum": [
        "human",
        "rule",
        "system"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    },
    "basis": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "exception": {
      "type": "boolean"
    },
    "closure_check": {
      "enum": [
        "passed",
        "exception",
        "not_configured",
        null
      ]
    },
    "mode_at_write": {
      "enum": [
        "event",
        "external_ref",
        null
      ]
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "holder_check_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "event_id",
    "case_id",
    "seq",
    "event_type",
    "affects_state",
    "actor",
    "actor_kind",
    "occurred_at",
    "recorded_at",
    "basis",
    "evidence_refs",
    "cycle",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "affects_state": {
            "const": true
          }
        },
        "required": [
          "affects_state"
        ]
      },
      "then": {
        "required": [
          "to_state"
        ],
        "properties": {
          "to_state": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "CLOSE_EXCEPTION",
              "DISPOSITION_RECORDED",
              "DISPOSITION_REFERENCED",
              "QA_RELEASE_RECORDED",
              "ESIGNATURE_RECORDED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "holder_check_ref"
        ],
        "properties": {
          "actor_kind": {
            "const": "human"
          },
          "holder_check_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "REOPEN"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "basis": {
            "minLength": 1
          },
          "to_state": {
            "const": "REOPENED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CASE_CREATED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "from_state": {
            "type": "null"
          }
        }
      }
    }
  ]
}
