{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:error-envelope",
  "title": "error-envelope",
  "description": "Uniform error envelope (error-handling-spec.md) (Stage 12 v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "correlation_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E-[A-Z]+(-[A-Z0-9]+)+$"
        },
        "message": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
