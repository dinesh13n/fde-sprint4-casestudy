{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:evidence-record:v0.2",
  "title": "evidence-record",
  "description": "Evidence record (FR-DEC-04) (Stage 12 v0.2 addendum, derived from v0.1 DRAFT; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "ev_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "document",
        "intake_item",
        "crosswalk_object",
        "external_ref"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_level": {
      "enum": [
        "engineering",
        "quality",
        "operations",
        "restricted"
      ]
    },
    "attached_by": {
      "type": "string"
    },
    "attached_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"
    }
  },
  "required": [
    "ev_id",
    "kind",
    "source",
    "source_ref",
    "access_level",
    "attached_by",
    "attached_at"
  ],
  "additionalProperties": false
}
