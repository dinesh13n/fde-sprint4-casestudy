{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gxp-hub:schema:hub-config:v0.2",
  "title": "hub-config",
  "description": "Effective hub configuration (defaults applied) (Stage 12 v0.2 addendum; synthetic, unvalidated)",
  "type": "object",
  "properties": {
    "data_origin": {
      "enum": [
        "synthetic",
        "production"
      ],
      "description": "the hub accepts only 'synthetic' until HAR-15 (hub.config.validate)"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kill": {
          "type": "boolean"
        }
      },
      "required": [
        "kill"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "floor": {
          "enum": [
            "3.10",
            "3.12"
          ]
        }
      },
      "required": [
        "floor"
      ]
    },
    "capability_authority": {
      "type": "object",
      "description": "capability -> shadow | authoritative; authoritative needs approval_refs['capability_authority.<cap>'] (DW-17, FF-2 rule 3)",
      "additionalProperties": {
        "enum": [
          "shadow",
          "authoritative"
        ]
      }
    },
    "approval_refs": {
      "type": "object",
      "description": "flag path -> reference to the recorded human approval (DW-17); the hub cannot verify the reference",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "zone_h": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "holders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "ships empty (FR-GATE-04)"
        },
        "reauth_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "holders",
        "reauth_window_seconds"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string"
        },
        "exposure_approved": {
          "type": "boolean"
        },
        "exposure_approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cert_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_file": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "bind",
        "exposure_approved",
        "exposure_approval_ref",
        "tls"
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_every": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "anchor_path",
        "anchor_every"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pbkdf2_iterations": {
          "type": "integer",
          "minimum": 600000
        },
        "password_min_length": {
          "type": "integer",
          "minimum": 12,
          "maximum": 1024
        },
        "lockout_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "lockout_window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "lockout_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "session_idle_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "session_absolute_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "event",
            "external_ref"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "values"
      ]
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unconfigured_behaviour": {
          "enum": [
            "treat_label_CLOSED_as_closing",
            "none"
          ]
        }
      },
      "required": [
        "unconfigured_behaviour"
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_table": {
          "enum": [
            "structural",
            "strict"
          ]
        },
        "transitions": {
          "type": "object"
        }
      },
      "required": [
        "transition_table",
        "transitions"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derivation": {
          "enum": [
            "human_only"
          ]
        }
      },
      "required": [
        "derivation"
      ]
    },
    "case_creation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "job": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{2}:[0-9]{2}$"
              }
            },
            "required": [
              "job",
              "at"
            ]
          }
        },
        "grace_minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "heartbeat_stale_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fts": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "max_doc_chars": {
          "type": "integer",
          "minimum": 100
        },
        "require_c3_reason": {
          "type": "boolean"
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contract_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "contract_file",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "contract_file": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "enforce",
              "record_only"
            ]
          }
        }
      }
    }
  },
  "required": [
    "zone_h",
    "disposition",
    "closure",
    "schedule",
    "data_origin"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "properties": {
              "mode": {
                "const": "event"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "required": [
              "values"
            ]
          }
        }
      }
    }
  ]
}
